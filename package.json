{
  "name": "pi-retry-kit",
  "private": false,
  "version": "0.6.1",
  "type": "module",
  "description": "Resilience plugin for pi: silent unconditional retry + first-token watchdog + circuit breaker / auto model failover, in one request-layer wrapper. No messages injected, no reliance on pi built-in retry.",
  "keywords": [
    "pi-package",
    "retry",
    "ttft",
    "time-to-first-token",
    "watchdog",
    "quota",
    "rate-limit",
    "stall",
    "first-token",
    "toolkit",
    "extension"
  ],
  "scripts": {
    "build": "echo 'nothing to build (jiti loads TS directly)'",
    "check": "echo 'nothing to check'",
    "test": "bun test test/",
    "typecheck": "echo \"typecheck via tsconfig (see tsconfig.check.json)\""
  },
  "pi": {
    "extensions": [
      "./extensions/pi-resilience.ts",
      "./extensions/pi-notify.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.2"
  }
}